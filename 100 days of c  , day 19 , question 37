#include <stdio.h>

int main()
{
    int a, b, x, y, remainder, hcf, lcm;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    x = a;
    y = b;

    while (y != 0)
    {
        remainder = x % y;
        x = y;
        y = remainder;
    }

    hcf = x;

    lcm = (a * b) / hcf;

    printf("LCM = %d", lcm);

    return 0;
}
