#include <stdio.h>

int main(){
    int n, i;
    long product = 1;
    
    printf("Enter the number : ");
    scanf("%d" , &n);

    if ( n % 2 != 0){
        printf(" %d is not an even number.\n");
        return 0;
    }
    if ( n<2){
        printf("No even numbers found.\n");
        return 0;
    }
    printf("2");
    product = product * 2;

    for ( i = 4; i<=n; i += 2){
        printf(" * %d", i);
        product = product * i;
    }

    printf(" = %ld\n", product);
    return 0;

}
