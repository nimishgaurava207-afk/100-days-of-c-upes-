#include <stdio.h>

int main() {
    int num;
    int binary[32];
    int i = 0;

    
    printf("Enter a decimal number: ");
    if (scanf("%d", &num) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    
    if (num == 0) {
        printf("Binary representation: 0\n");
        return 0;
    }

    
    int is_negative = 0;
    if (num < 0) {
        is_negative = 1;
        num = -num; 
    }

   
    while (num > 0) {
        binary[i] = num % 2; 
        num = num / 2;       
        i++;                 
    }

    
    printf("Binary representation: ");
    if (is_negative) {
        printf("-"); // Print negative sign if applicable
    }

   
    for (int j = i - 1; j >= 0; j--) {
        printf("%d", binary[j]);
    }
    printf("\n");

    return 0;
}
