#include <stdio.h>

int main() {
    int n1, n2;

    if (scanf("%d %d", &n1, &n2) != 2) {
        return 1;
    }

    // Ensure numbers are positive
    n1 = (n1 < 0) ? -n1 : n1;
    n2 = (n2 < 0) ? -n2 : n2;

    while (n1 != n2 && n1 > 0 && n2 > 0) {
        if (n1 > n2) {
            n1 -= n2;
        } else {
            n2 -= n1;
        }
    }

    int hcf = (n1 == 0) ? n2 : n1;
    printf("%d\n", hcf);

    return 0;
}
