
#include <stdio.h>

int main() {
    int num, digit, product = 1, hasOdd = 0;

    if (scanf("%d", &num) != 1) {
        return 1;
    }

    if (num < 0) {
        num = -num;
    }

    if (num == 0) {
        product = 0;
    }

    while (num > 0) {
        digit = num % 10;
        if (digit % 2 != 0) {
            product *= digit;
            hasOdd = 1;
        }
        num /= 10;
    }

    if (hasOdd == 0) {
        product = 0;
    }

    printf("%d\n", product);

    return 0;
}
