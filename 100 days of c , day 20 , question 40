
#include <stdio.h>

int main() {
    char binary[100];

    if (scanf("%99s", binary) != 1) {
        return 1;
    }

    for (int i = 0; binary[i] != '\0'; i++) {
        if (binary[i] == '0') {
            binary[i] = '1';
        } else if (binary[i] == '1') {
            binary[i] = '0';
        } else {
            return 1;
        }
    }

    printf("%s\n", binary);

    return 0;
}
