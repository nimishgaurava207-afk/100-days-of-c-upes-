#include <stdio.h>

int main ()
{
    int n, i;
    float sum = 0.0;

    printf("Enter the number of terms (n): ");
    scanf("%d", &n);

    for ( int i = 1; i <= n; i++) {
        if (i == 1){
            sum += 1.0;
        } else {
            float numerator = 2 * i - 1;
            float denominator = 2 * i;

            sum += numerator / denominator;
        }
    }
    printf("Approximate sum: %.1f\n", sum);
    return 0;
}
