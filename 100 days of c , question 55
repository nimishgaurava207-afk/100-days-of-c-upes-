#include <stdio.h>

int main() {
    int n, i, j, isPrime;

    
    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int arr[n];

    
    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr[i]);
    }

  
    printf("\nThe prime numbers in the array are: ");
    for (i = 0; i < n; i++) {
        
        
        isPrime = 1;

        
        if (arr[i] <= 1) {
            isPrime = 0;
        } else {
            
            for (j = 2; j < arr[i]; j++) {
                if (arr[i] % j == 0) {
                    isPrime = 0; // Found a factor, so it is NOT prime
                    break;       // Stop checking this number
                }
            }
        }

        
        if (isPrime == 1) {
            printf("%d ", arr[i]);
        }
    }

    printf("\n");
    return 0;
}
