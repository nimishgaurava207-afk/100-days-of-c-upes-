#include <stdio.h>

int main() {
    int numbers[5];
    
    printf("Enter 5 integers:\n");
    for(int i = 0 ; i < 5 ; i++){
        // Fixed: Changed numbers[i]0; to numbers[i]);
        scanf("%d", &numbers[i]);
    }
    
    
    printf("\nYour array elements are:\n");
    for(int i = 0 ; i < 5 ; i++){
        printf("Index %d : %d\n", i, numbers[i]);
    }
    
    return 0;
}
