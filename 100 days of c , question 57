#include <stdio.h>

int main() {
    int arr[5];
    int i;
    int sum = 0;
    
    printf("Enter 5 numbers:\n"); 
    
    for(i = 0 ; i < 5 ; i ++){
        scanf("%d", &arr[i]);
    }
    
    
    for(i = 0; i < 5; i++){
        sum = sum + arr[i];
    }
    
    
    printf("The sum is: %d\n", sum); 
    
    return 0; // Fixed: Added missing semicolon
}
